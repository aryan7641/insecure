# INSecure Backend — Environment Variables
NODE_ENV=production
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://aryansharma7641_db_user:YOURPASSWORD@cluster0.5ygb4de.mongodb.net/insecure?appName=Cluster0&compressors=zlib

# JWT Authentication
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# AWS S3 Document Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your_s3_bucket_name

# CORS - set to your Vercel frontend URL
CORS_ORIGIN=https://insecure-fr.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Google OAuth (optional for V1)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-ec2-domain/api/auth/google/callback
